# Bad arguments must print the usage line on stderr and exit 2.
set(usage "^usage: drape_dump --out <file\\.obj> \\[--size XS\\|S\\|M\\|L\\|XL\\|XXL\\] \\[--quality draft\\|standard\\|fine\\] \\[--body male\\|female\\]\n$")
foreach(bad "--size;XXXL" "--out;unused.obj;--body;alien")
  string(REPLACE ";" " " shown "${bad}")
  execute_process(COMMAND ${DUMP} ${bad} RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
  if(NOT rc EQUAL 2)
    message(FATAL_ERROR "drape_dump ${shown} exited ${rc}, expected 2")
  endif()
  if(NOT err MATCHES "${usage}")
    message(FATAL_ERROR "drape_dump ${shown}: missing usage line, got: ${err}")
  endif()
endforeach()
